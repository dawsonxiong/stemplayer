{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stemplayer",
  "account_id": "28cf8412596e686a740a117e47df06c4",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",

  // R2 bucket for audio files (uploads + stems)
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "stem-player-audio"
    }
  ],

  // KV namespace for job status tracking
  "kv_namespaces": [
    {
      "binding": "JOBS",
      "id": "fb452fa6ee744fea9dc76d2d48c4637f"
    }
  ],

  "vars": {
    "MODAL_ENDPOINT": "https://dawsonxiong--stem-demucs-separate-api.modal.run",
    "R2_PUBLIC_ENDPOINT": "https://28cf8412596e686a740a117e47df06c4.r2.cloudflarestorage.com"
  }

  // Secrets (set via: npx wrangler secret put <NAME>):
  // - R2_ACCESS_KEY_ID
  // - R2_SECRET_ACCESS_KEY
  // - WEBHOOK_SECRET
}
