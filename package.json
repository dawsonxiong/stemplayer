{
  "name": "stemplayer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite dev",
    "postinstall": "pnpm cf-typegen",
    "preview": "pnpm build && vite preview",
