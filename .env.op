# 1Password references only; real values stay in the Stem Player vault.
# Read by `pnpm dev` (scripts/dev.mjs), or: op run --account my.1password.com --env-file=.env.op -- <cmd>
WEBHOOK_SECRET=op://Stem Player/Stem Player webhook secret/credential
# R2 keys live in the "Cloudflare" API credential in the Private vault. Referenced
# by item ID because a Cloudflare login item in the same vault shares the name.
R2_ACCESS_KEY_ID=op://Private/cjcv66uez74t24hjpjhegtmini/CLOUDFLARE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=op://Private/cjcv66uez74t24hjpjhegtmini/CLOUDFLARE_R2_SECRET_ACCESS_KEY
