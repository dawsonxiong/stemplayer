# Copy to .dev.vars for local development (`npm run dev`).
# In production these are set with: npx wrangler secret put <NAME>

# R2 API token with Object Read & Write on stem-player-audio.
# Cloudflare dashboard → R2 → Manage API tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Shared secret the Modal job sends back as the x-webhook-secret header.
# Must match the `webhook_secret` in the Modal `r2-creds` flow — any random string.
WEBHOOK_SECRET=
